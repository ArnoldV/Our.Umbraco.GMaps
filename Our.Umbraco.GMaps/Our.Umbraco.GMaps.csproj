<!-- The Umbraco 18 flavour. Everything shared lives in Our.Umbraco.GMaps.props. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <UmbracoCmsVersion>[18.0.1,19.0.0)</UmbracoCmsVersion>
    <Version>18.2.1</Version>
    <Description>Google Maps with autocomplete property editor for Umbraco 18</Description>
    <DefineConstants>$(DefineConstants);UMBRACO_18</DefineConstants>

    <!-- Umbraco 18 / Microsoft.AspNetCore.OpenApi: the OpenAPI source generator flows in via
         Umbraco's project reference, but the property that enables it ships only with the Web SDK.
         Class libraries registering OpenAPI documents must opt in explicitly. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <Import Project="Our.Umbraco.GMaps.props" />

</Project>
