<!--
  Shared definition of the Our.Umbraco.GMaps package, imported by one project file per
  supported Umbraco major. Each of those sets only what actually differs: the Umbraco
  dependency range, the package version and description, and the compilation symbol.

  See Docs/multi-version-support.md for why there is a project file per major rather than
  a single project driven by a property.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>

    <!-- Every flavour produces the same assembly and package identity; only the version
         stream differs. The file name of the project must not leak into either. -->
    <AssemblyName>Our.Umbraco.GMaps</AssemblyName>
    <RootNamespace>Our.Umbraco.GMaps</RootNamespace>
    <PackageId>Our.Umbraco.GMaps</PackageId>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <Product>$(AssemblyName) - Google Maps for Umbraco</Product>
    <Title>Our.Umbraco.GMaps</Title>
    <PackageTags>Umbraco Google Maps google-maps umbraco-marketplace</PackageTags>
    <Authors>Arnold Visser</Authors>
    <Company>Arnold Visser</Company>
    <PackageReleaseNotes>Improvements to Property Editor</PackageReleaseNotes>
    <Copyright>Copyright © Arnold Visser</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/ArnoldV/Our.Umbraco.GMaps</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArnoldV/Our.Umbraco.GMaps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- UmbracoCmsVersion is a bounded range set by the importing project: it restores the
         floor of that major and flows an upper bound into the nuspec, so NuGet cannot offer
         a package built for one major to a site running another. -->
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoCmsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the Client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\readme.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
